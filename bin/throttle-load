#!/usr/bin/env bash
# Portable load snapshot. install.sh pins Python for launchd and hooks.
PYTHON=${AT_PYTHON:-python3}
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd); src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
root=$(cd -P "$(dirname "$src")/.." && pwd)
export PYTHONPATH="$root/lib${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m agent_throttle.load "$@"
