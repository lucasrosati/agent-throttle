#!/usr/bin/env bash
# solo <command...>: a bounded number of heavy validations at a time on the machine (a semaphore shared by every agent and terminal).
#
# The lock is a directory created with mkdir (atomic). The command runs as a background child: its PID goes to
# $LOCK/child together with its start time (against PID reuse). If the lock owner dies (kill -9), the next solo kills
# the child's process tree before taking the slot. A watchdog enforces the timeout (config semaphore.timeout_s,
# SOLO_TIMEOUT overrides), counted from the start of the command: waiting for the slot does not count. On timeout the
# whole tree is killed, the slot is released and solo exits with 124 (note "timeout" in the log).
# Log: one TSV line per run in <logs.dir>/semaphore.log: date, wait_s, duration_s, rc, cwd, command, note.
# Settings come from `throttle-config shell`; if it fails, the built-in defaults below apply (the lock never depends
# on Python).

PYTHON=${AT_PYTHON:-python3}   # pinned by install.sh
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd); src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
here=$(cd -P "$(dirname "$src")" && pwd)

if [ $# -eq 0 ] || [ "$1" = -h ] || [ "$1" = --help ]; then
  echo "usage: solo <command...>   (runs the command when a solo slot is available; exit code = the command's)"
  [ $# -eq 0 ] && exit 64 || exit 0
fi

if cfg=$("$here/throttle-config" shell 2>/dev/null); then
  eval "$cfg"
else
  echo "[solo] throttle-config failed; using built-in defaults" >&2
  export PLAYWRIGHT_HTML_OPEN=never
fi
ROOT=$(cd "$here/.." && pwd)
read -r C S <<EOF
$("$PYTHON" "$ROOT/lib/agent_throttle/machine.py" "${SOLO_CORES:-${AT_SEMAPHORE_CORES:-auto}}" "${SOLO_SLOTS:-${AT_SEMAPHORE_SLOTS:-auto}}" 2>/dev/null)
EOF
case "$C" in ''|*[!0-9]*|0) C=1 ;; esac
case "$S" in ''|*[!0-9]*|0) S=1 ;; esac
BASE_LOCK=${AT_SEMAPHORE_LOCK_DIR:-/tmp/agent-throttle.lock}
LOG=${AT_LOG_SEMAPHORE:-$HOME/.local/state/agent-throttle/semaphore.log}
POLL=${AT_SEMAPHORE_POLL_S:-15}
STALE=${AT_SEMAPHORE_STALE_LOCK_S:-60}
DEFAULT_TIMEOUT=${AT_SEMAPHORE_TIMEOUT_S:-1200}
case "$DEFAULT_TIMEOUT" in ''|*[!0-9]*|0) DEFAULT_TIMEOUT=1200 ;; esac
TIMEOUT=${SOLO_TIMEOUT:-$DEFAULT_TIMEOUT}
case "$TIMEOUT" in ''|*[!0-9]*|0) echo "[solo] SOLO_TIMEOUT invalid ($TIMEOUT); using $DEFAULT_TIMEOUT s"; TIMEOUT=$DEFAULT_TIMEOUT ;; esac

descendants() { # the tree under $1, leaves first
  local c
  for c in $(pgrep -P "$1" 2>/dev/null); do descendants "$c"; done
  echo "$1"
}

kill_tree() { # TERM on the tree; after 5 s, KILL what is left
  local pids alive p
  pids=$(descendants "$1")
  # shellcheck disable=SC2086 # one PID per word
  kill -TERM $pids 2>/dev/null
  for _ in 1 2 3 4 5; do
    alive=""
    for p in $pids; do kill -0 "$p" 2>/dev/null && alive="$alive $p"; done
    [ -z "$alive" ] && return 0
    sleep 1
  done
  # shellcheck disable=SC2086
  kill -KILL $alive 2>/dev/null
  echo "[solo] KILL on:$alive"
}

started_at() { ps -p "$1" -o lstart= 2>/dev/null; }

owner_alive() {
  local pid stored current
  pid=$(cat "$1/pid" 2>/dev/null)
  case "$pid" in ''|*[!0-9]*|0) return 0 ;; esac  # malformed identity is not permission to reap
  kill -0 "$pid" 2>/dev/null || return 1
  [ ! -f "$1/pid_start" ] && return 0  # locks from older versions
  stored=$(cat "$1/pid_start" 2>/dev/null)
  current=$(started_at "$pid")
  [ -z "$stored" ] || [ -z "$current" ] && return 0  # inconclusive ps read: do not steal
  [ "$current" = "$stored" ]
}

mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }  # GNU first: on Linux, stat -f means "filesystem"

reap_orphan_child() {
  local child start
  child=$(cat "$LOCK/child" 2>/dev/null)
  start=$(cat "$LOCK/child_start" 2>/dev/null)
  if [ -n "$child" ] && [ -n "$start" ] && kill -0 "$child" 2>/dev/null && [ "$(started_at "$child")" = "$start" ]; then
    echo "[solo] killing the tree of orphan child $child ($(cat "$LOCK/cmd" 2>/dev/null))"
    kill_tree "$child"
  fi
}

# What goes to the log: tabs/newlines become spaces; the value of VAR=..., of --*token/secret/pass/key* options and a
# credential in a URL (://user:password@) become ***.
sanitize() {
  printf '%s' "$*" | tr '\t\n\r' '   ' | sed -E \
    -e 's/(^|[[:space:]])([A-Za-z_][A-Za-z0-9_]*)=[^[:space:]]*/\1\2=***/g' \
    -e 's/(--?[A-Za-z0-9_-]*([Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss]|[Kk][Ee][Yy])[A-Za-z0-9_-]*)(=|[[:space:]]+)[^[:space:]]+/\1\3***/g' \
    -e 's#://[^/@[:space:]]+@#://***@#g'
}

t0=$(date +%s)
slotdir() { if [ "$1" = 1 ]; then printf '%s\n' "$BASE_LOCK"; else printf '%s.%s\n' "$BASE_LOCK" "$1"; fi; }
GATE_PCT=${SOLO_GATE_PCT:-${AT_SEMAPHORE_GATE_PCT:-25}}
GATE_MB=${SOLO_GATE_MB:-${AT_SEMAPHORE_GATE_MB:-auto}}
case "$GATE_PCT" in ''|*[!0-9]*) GATE_PCT=25 ;; esac
case "$GATE_MB" in auto) ;; ''|*[!0-9]*|0) GATE_MB=auto ;; esac
WAIT_REASON=""
SLOT=""
while [ -z "$SLOT" ]; do
  gate=""
  for k in $(seq 1 "$S"); do
    LOCK=$(slotdir "$k")
    if [ "$k" -gt 1 ]; then
      if ! gate=$("$PYTHON" "$ROOT/lib/agent_throttle/gate.py" "$LOG" "$GATE_PCT" "$GATE_MB" 2>/dev/null); then
        gate="memory: read failed"
      fi
      if [ -n "$gate" ]; then WAIT_REASON=$gate; break; fi
    fi
    if mkdir "$LOCK" 2>/dev/null; then SLOT=$k; break; fi
    owner=$(cat "$LOCK/pid" 2>/dev/null)
    if [ -n "$owner" ] && ! owner_alive "$LOCK"; then
      echo "[solo] orphan lock of PID $owner"; reap_orphan_child; rm -rf "$LOCK"
      if mkdir "$LOCK" 2>/dev/null; then SLOT=$k; break; fi
    fi
    if [ -z "$owner" ] && [ $(( $(date +%s) - $(mtime "$LOCK" || date +%s) )) -gt "$STALE" ]; then
      echo "[solo] lock without owner removed"; reap_orphan_child; rm -rf "$LOCK"
      if mkdir "$LOCK" 2>/dev/null; then SLOT=$k; break; fi
    fi
  done
  [ -n "$SLOT" ] && break
  [ -z "$gate" ] && WAIT_REASON="slots busy"
  echo "[solo] $WAIT_REASON; waiting..."
  sleep "$POLL"
done
echo $$ > "$LOCK/pid"; started_at $$ > "$LOCK/pid_start"; echo "$PWD :: $*" > "$LOCK/cmd"
OWNER_START=$(cat "$LOCK/pid_start")
release() {
  if [ "$(cat "$LOCK/pid" 2>/dev/null)" = "$$" ] && [ "$(cat "$LOCK/pid_start" 2>/dev/null)" = "$OWNER_START" ]; then
    rm -rf "$LOCK"
  fi
}
trap release EXIT
# The directory just acquired counts even before its owner files are complete.
active=0
for k in $(seq 1 "$S"); do [ -d "$(slotdir "$k")" ] && active=$((active + 1)); done
[ "$active" -lt 1 ] && active=1
W=$(( C / active )); WMAX=$(( (C + 1) / 2 ))
[ "$W" -gt "$WMAX" ] && W=$WMAX
[ "$W" -lt 1 ] && W=1
printf '%s\n' "$W" > "$LOCK/w"
PW_MAX=${SOLO_PW_MAX:-${AT_SEMAPHORE_PLAYWRIGHT_MAX_WORKERS:-4}}
case "$PW_MAX" in ''|*[!0-9]*|0) PW_MAX=4 ;; esac
WPW=$W; [ "$WPW" -gt "$PW_MAX" ] && WPW=$PW_MAX
export SOLO_W=$W SOLO_W_PW=$WPW SOLO_CORES=$C SOLO_SLOT=$SLOT SOLO_SLOT_DIR=$LOCK
PRELOAD=$ROOT/lib/agent_throttle/workers-preload.cjs
export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--require=\"$PRELOAD\""
: > "$LOCK/wlog"
echo "[solo] slot $SLOT/$S, W=$W (Playwright $WPW)"
child=""; watchdog=""
# shellcheck disable=SC2046,SC2317,SC2329 # one PID per word; called by the trap below
on_signal() { [ -n "$child" ] && kill_tree "$child"; [ -n "$watchdog" ] && kill -TERM $(descendants "$watchdog") 2>/dev/null; exit 130; }
trap on_signal INT TERM HUP

start=$(date +%s)
wait_s=$(( start - t0 ))
if ! "$PYTHON" "$ROOT/lib/agent_throttle/workers.py" "$W" "$C" "$WPW" "$@" > "$LOCK/argv"; then
  echo "[solo] worker rewrite failed; command not started" >&2; exit 70
fi
ARGS=()
while IFS= read -r -d '' a; do ARGS+=("$a"); done < "$LOCK/argv"
"${ARGS[@]}" <&0 &
child=$!
echo "$child" > "$LOCK/child"; started_at "$child" > "$LOCK/child_start"
watchdog_safe() {
  kill -0 $$ 2>/dev/null && [ "$(cat "$LOCK/pid" 2>/dev/null)" = "$$" ] || return 1
  [ -n "$OWNER_START" ] && [ "$(started_at $$)" = "$OWNER_START" ] || return 1
  [ "$(cat "$LOCK/pid_start" 2>/dev/null)" = "$OWNER_START" ] || return 1
  local child_start
  child_start=$(cat "$LOCK/child_start" 2>/dev/null)
  [ -n "$child_start" ] && [ "$(started_at "$child")" = "$child_start" ]
}
# An orphan watchdog cannot act on a replacement owner or a reused child PID.
( sleep "$TIMEOUT"
  watchdog_safe || exit 0
  echo "$TIMEOUT" > "$LOCK/timeout"; kill_tree "$child" >/dev/null 2>&1 ) &
watchdog=$!
wait "$child"; rc=$?
# shellcheck disable=SC2046
kill -TERM $(descendants "$watchdog") 2>/dev/null; wait "$watchdog" 2>/dev/null   # without kill_tree's 1 s wait
note=""
if [ -f "$LOCK/timeout" ]; then
  rc=124; note=timeout
  echo "[solo] TIMEOUT: over ${TIMEOUT}s (semaphore.timeout_s / SOLO_TIMEOUT); the command's tree was killed"
fi
dur=$(( $(date +%s) - start ))
echo "[solo] rc=$rc in ${dur}s (wait ${wait_s}s)"
# the log is written while the slot is still held (the EXIT trap releases it afterwards): two writes never interleave
mkdir -p "$(dirname "$LOG")" 2>/dev/null
[ -s "$LOG" ] || printf 'date\twait_s\tduration_s\trc\tcwd\tcommand\tnote\n' >> "$LOG"
printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$wait_s" "$dur" "$rc" "$(sanitize "$PWD")" "$(sanitize "$*")" "$note" >> "$LOG"
exit $rc
